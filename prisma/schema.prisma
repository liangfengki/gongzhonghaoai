generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthCode {
  id         String    @id @default(cuid())
  code       String    @unique
  usageCount Int       @default(0)
  maxUsage   Int       @default(10)
  deviceId   String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
